{
  "name": "rag-qna",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test \"tests/**/*.test.ts\"",
    "db:migrate": "tsx scripts/init-db.ts",
    "init-db": "tsx scripts/init-db.ts",
    "db:import-legacy": "tsx scripts/import-legacy.ts",
    "seed": "tsx scripts/seed.ts",
    "worker": "node --conditions=react-server --import tsx scripts/worker.ts",
    "build:scripts": "node scripts/build-scripts.mjs",
    "start:worker": "node --conditions=react-server dist/scripts/worker.cjs",
    "fmt": "prettier --write . --ignore-unknown",
    "secrets:reseal": "node --conditions=react-server --import tsx scripts/reseal-secrets.ts"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@tesseract.js-data/eng": "^1.0.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.577.0",
    "next": "15.5.26",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "swr": "^2.3.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.5.6",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
