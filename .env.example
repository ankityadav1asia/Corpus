# ─── Required ────────────────────────────────────────────────────────────────
# Neon (or any Postgres 15+ with pgvector ≥ 0.5) connection string
POSTGRES_URL="postgresql://user:password@host/db?sslmode=require"

# Signs session cookies and encrypts stored credentials. At least 32 random characters, e.g.:
# openssl rand -hex 32. There is NO fallback: the app refuses to authenticate anyone without it.
AUTH_SECRET=""
# While rotating AUTH_SECRET: the old value, still accepted for sessions and stored secrets.
# Remove it after `npm run secrets:reseal` and 7 days (docs/SECURITY.md → "Rotating AUTH_SECRET").
# AUTH_SECRET_PREVIOUS=""

# Gemini API key (https://aistudio.google.com/apikey). GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=""

# ─── Required in production ─────────────────────────────────────────────────
# Public origin of the app. OAuth redirect URIs are built from this, never from the Host header.
# For local `npm run start`, use http://localhost:3000
APP_URL=""

# ─── Optional: models ───────────────────────────────────────────────────────
# GEMINI_CHAT_MODEL="gemini-3.6-flash"
# Open-weight Gemma models also run through the Gemini API (separate quota from Gemini models):
# GEMINI_CHAT_MODEL="gemma-4-26b-a4b-it"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# Speed: short helper calls (re-ranking, deep-search planning, quality scores, follow-up questions)
# always run with the model's "thinking" turned off. Optionally send them to a smaller model too:
# GEMINI_FAST_MODEL="gemini-2.5-flash-lite"
# OPENAI_COMPATIBLE_FAST_MODEL="qwen3:4b"      # when CHAT_PROVIDER=openai-compatible
# Image generation (needs billing on the Gemini key); "none" turns it off.
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# ─── Optional: open-source models (Ollama, vLLM, LM Studio, LocalAI, Groq, OpenRouter …) ──
# Any server with an OpenAI-compatible API. Chat and embeddings are chosen separately, so you can
# e.g. answer with a local Llama/Qwen/Gemma and keep Gemini embeddings (or the other way round).
# CHAT_PROVIDER="openai-compatible"            # gemini (default) | openai-compatible
# EMBEDDING_PROVIDER="openai-compatible"       # gemini (default) | openai-compatible
# OPENAI_COMPATIBLE_BASE_URL="http://localhost:11434/v1"   # Ollama
# OPENAI_COMPATIBLE_API_KEY=""                 # only if the server needs one
# OPENAI_COMPATIBLE_CHAT_MODEL="qwen3:8b"
# OPENAI_COMPATIBLE_EMBEDDING_MODEL="nomic-embed-text"
# OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=""      # when embeddings are served elsewhere
# Every chunk records the model that embedded it and search only compares vectors of the active model
# (vectors up to 3072 dimensions; smaller ones are zero-padded). After switching the embedding model,
# an admin re-embeds the workspace from Workspace settings → Models.

# ─── Optional: multimodal sources and OCR ───────────────────────────────────
# Images are described by a vision model, audio/video are transcribed, scanned PDFs are read with OCR.
# With a Gemini key these work out of the box; "none" turns a capability off.
# VISION_PROVIDER="gemini"                     # gemini | openai-compatible | none
# GEMINI_VISION_MODEL=""                       # default: the chat model
# OPENAI_COMPATIBLE_VISION_MODEL="qwen2.5vl:7b"
# TRANSCRIPTION_PROVIDER="gemini"              # gemini | openai-compatible (Whisper API) | none
# GEMINI_TRANSCRIPTION_MODEL=""                # default: the chat model (a Gemini model when chat is Gemma)
# OPENAI_COMPATIBLE_TRANSCRIPTION_MODEL="whisper-1"
# OPENAI_COMPATIBLE_TRANSCRIPTION_BASE_URL=""
# OCR: tesseract (default; open source, runs on the server, English data bundled, no quota),
# vision (the vision model reads the page; better on handwriting and complex layouts) or none.
# OCR_ENGINE="tesseract"
# OCR_LANGUAGES="eng"                          # e.g. eng+hin (other languages download traineddata on first use)

# ─── Optional: audio overviews (text-to-speech, two hosts) ──────────────────
# TTS_PROVIDER="gemini"                        # gemini | openai-compatible (/audio/speech, e.g. Kokoro) | none
# GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
# GEMINI_TTS_VOICES="Kore,Puck"
# OPENAI_COMPATIBLE_TTS_MODEL="kokoro"
# OPENAI_COMPATIBLE_TTS_BASE_URL="http://localhost:8880/v1"
# OPENAI_COMPATIBLE_TTS_VOICES="af_heart,am_michael"

# ─── Optional: who may sign in ──────────────────────────────────────────────
# Empty = anyone can create an account (with a private personal workspace). Invitations to team
# workspaces do not bypass these lists.
# AUTH_ALLOWED_EMAILS="me@example.com,colleague@example.com"
# AUTH_ALLOWED_DOMAINS="example.com"

# ─── Optional: Google / GitHub sign-in ──────────────────────────────────────
# Redirect URI to register: <APP_URL>/api/auth/oauth/callback?provider=google (or github)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
#
# The Google client also enables the Google Drive connector (read-only). Additionally:
#   - register the redirect URI <APP_URL>/api/connectors/google-drive/callback
#   - enable the Google Drive API in the same Google Cloud project
#   - add the scope .../auth/drive.readonly to the OAuth consent screen
# Notion (integration token), GitHub (optional personal access token) and website connectors need
# no server configuration. Connector tokens are encrypted with a key derived from AUTH_SECRET.
#
# Slack and Microsoft Teams bots are connected by workspace admins in the app (Workspace settings →
# Chat apps); they need APP_URL to be the public https origin the platforms can reach.

# ─── Optional: email sign-in codes (pick one) ───────────────────────────────
# Without a provider, development servers print the code to the server console;
# production servers refuse to issue codes.
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Corpus <login@yourdomain.com>"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASS=""
# GMAIL_USER=""
# GMAIL_APP_PASSWORD=""

# ─── Optional: rate limiting behind a proxy ─────────────────────────────────
# Number of trusted reverse proxies that append the client address to X-Forwarded-For:
# 1 behind Render, Railway or Fly; 2 with a CDN in front of them (automatic on Vercel).
# Unset = the header is ignored and per-IP limits share one bucket. Never set it higher than the
# real number of proxies: clients could then choose their own address.
# TRUST_PROXY="1"

# ─── Optional: re-ranking ───────────────────────────────────────────────────
# auto (default): Cohere Rerank when COHERE_API_KEY is set, otherwise Gemini grades the passages.
# llm | cohere | none force a choice. Per-workspace settings can also turn re-ranking off.
# RERANKER="auto"
# COHERE_API_KEY=""
# COHERE_RERANK_MODEL="rerank-v3.5"

# ─── Optional: background jobs ──────────────────────────────────────────────
# Jobs (indexing, OCR, transcription, reports, audio, syncs, evaluation) run after requests and
# via `npm run worker`. With a dedicated worker, keep them out of the web server:
# WEB_RUNS_JOBS="false"
# Setting this enables GET/POST /api/jobs/run with "Authorization: Bearer <CRON_SECRET>" for a
# scheduler such as Vercel Cron. At least 16 characters, e.g.: openssl rand -hex 24
# CRON_SECRET=""

# ─── Local development without a database server ────────────────────────────
# POSTGRES_URL="pglite:./.data/pglite"   # in-process Postgres + pgvector; one process at a time; not for production
