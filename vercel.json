{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "regions": ["cle1"],
  "fluid": true,
  "functions": {
    "api/go.go": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/jobs/run",
      "schedule": "0 3 * * *"
    }
  ]
}
